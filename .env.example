# Copy to .env (git-ignored) and adjust. Every value is optional: defaults live in app/config.py.
# NEVER put real secrets in this file - it is committed.

# --- Chunking ---
CHATPDF_CHUNK_SIZE=800
CHATPDF_CHUNK_OVERLAP=150

# --- Embeddings ---
CHATPDF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval ---
CHATPDF_TOP_K=4

# --- LLM: auto | ollama | groq | huggingface ---
# auto = Ollama if running, else Groq if a key is set, else local Hugging Face model
CHATPDF_LLM_PROVIDER=auto
CHATPDF_OLLAMA_MODEL=llama3.2:3b
CHATPDF_OLLAMA_HOST=http://localhost:11434
CHATPDF_GROQ_MODEL=llama-3.1-8b-instant
CHATPDF_HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# --- Secrets: set as real environment variables, or in your local .env only ---
# GROQ_API_KEY=
